# ─────────────────────────────────────────────────────────────────────────────
#  Copy to `.env` — `cp .env.example .env` — and fill in AUTH_SECRET.
#  Everything else already works as it stands for local development.
#  `.env` is git-ignored; this file is the one that is committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ────────────────────────────────────────────────────────────────

# The SQLite file, read by both the app (lib/db.ts) and the Prisma CLI
# (prisma.config.ts). Relative paths resolve against the project root, which is
# where `prisma migrate` puts the file. WAL mode adds `dev.db-wal` and
# `dev.db-shm` beside it — they are as much "the database" as dev.db itself.
DATABASE_URL="file:./dev.db"

# Signs the session cookie (Auth.js) and the native app's bearer tokens
# (lib/mobile-token.ts) — one secret, both paths. Changing it signs everybody
# out. Generate one with:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# ── Optional: the seed ──────────────────────────────────────────────────────
# Read by all three seeds (prisma/seed.ts, seed-config.ts, seed-empty.ts).
# Set these before the *first* seed of a real deployment; the seeds upsert on
# the email, so changing it later adds a second administrator rather than
# renaming the first.

# The super administrator's email. Staff sign in with the local part of it —
# `admin@groupescolaire.ma` means signing in as `admin`.
# SEED_ADMIN_EMAIL="admin@groupescolaire.ma"

# The password every seeded account gets. Change it for anything but a demo.
# SEED_ADMIN_PASSWORD="Admin123!"

# The organisation's name, for `npm run db:seed:empty`. Everything else on the
# organisation — ICE, tax id, address, telephone — is filled in on
# /organization, because those head every receipt and a plausible wrong one is
# worse than a blank.
# SEED_ORG_NAME="Votre établissement"

# ── Optional: development ───────────────────────────────────────────────────

# `PRISMA_LOG_QUERIES=1 npm run dev` prints every SQL statement. Off by default:
# it is one line per query and the dashboard alone issues fifty. Ignored outside
# NODE_ENV=development.
# PRISMA_LOG_QUERIES=0
