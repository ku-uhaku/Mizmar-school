model School {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Short human code used in listings and exports, e.g. "AL-AMAL-CASA".
  code  String
  name  String
  /// "PRESCHOOL" | "PRIMARY" | "MIDDLE" | "HIGH" | "GROUP"
  /// see modules/schools/enums.ts
  level String @default("GROUP")

  email   String?
  phone   String?
  website String?

  addressLine String?
  city        String?
  region      String?
  postalCode  String?
  country     String  @default("MA")

  directorName String?
  capacity     Int?
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schoolYears    SchoolYear[]
  memberships    Membership[]
  /// Users who currently have this school selected as their working context.
  usersInContext User[]       @relation("UserCurrentSchool")

  // ── Academic configuration (year-independent) ──────────────────────────────
  educationLevels EducationLevel[]
  levels          Level[]
  subjects        Subject[]
  rooms           Room[]
  /// Denormalised back-reference; a class always belongs to one of this school's
  /// years. See the invariant note on SchoolClass.schoolId.
  classes         SchoolClass[]
  /// What the school can charge. How much, per year, is FeeRate.
  feeTypes        FeeType[]

  // ── Vie scolaire ──────────────────────────────────────────────────────────
  /// Dossiers familiaux and the children on the books. Both are identity only;
  /// what a child does in a given year is an Enrollment, reached through it.
  families Family[]
  students Student[]

  // ── Logistique ────────────────────────────────────────────────────────────
  /// The fleet. Year-independent: what each bus does in a given year is a
  /// TransportRoute. See prisma/schema/transport/.
  vehicles Vehicle[]

  // ── Caisse ────────────────────────────────────────────────────────────────
  /// The tills the school collects at, what it spends under, and every movement
  /// of money either way. See prisma/schema/treasury/.
  cashRegisters     CashRegister[]
  expenseCategories ExpenseCategory[]
  cashOperations    CashOperation[]
  payments          Payment[]
  cheques           Cheque[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("schools")
}
