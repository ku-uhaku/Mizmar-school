model School {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Short human code used in listings and exports, e.g. "AL-AMAL-CASA".
  code  String
  name  String
  /// "PRESCHOOL" | "PRIMARY" | "MIDDLE" | "HIGH" | "GROUP"
  /// see modules/schools/enums.ts
  level String @default("GROUP")

  /// The establishment's code in MASSAR (منظومة مسار) — the code établissement
  /// every national return, class list and mark export is filed under.
  ///
  /// Nullable-unique within the organisation, the same pattern every other
  /// MASSAR mapping uses: a groupe scolaire may have mapped one school and not
  /// yet the other, but no two of its schools may claim the same code. See the
  /// note on Subject.massarCode.
  massarCode String?

  email   String?
  phone   String?
  website String?

  /// The school's own crest, shown in the shell whenever this school is the
  /// working context and printed on its paperwork.
  ///
  /// Either an `https:` URL or a `data:` URI — see lib/images.ts. A data URI
  /// keeps the whole application in one SQLite file, which is what makes a
  /// backup a single copy; the size cap in the validator is what stops that
  /// convenience turning into a 10 MB row.
  logoUrl String?

  addressLine String?
  city        String?
  region      String?
  postalCode  String?
  country     String  @default("MA")

  directorName String?
  capacity     Int?
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The policies this school sets for itself — grading scale, teaching week,
  /// matricule format, instalment count. Optional because every column has a
  /// default: a school with no row behaves exactly as one with the defaults.
  settings SchoolSettings?

  schoolYears    SchoolYear[]
  memberships    Membership[]
  /// Users who currently have this school selected as their working context.
  usersInContext User[]       @relation("UserCurrentSchool")

  // ── Academic configuration (year-independent) ──────────────────────────────
  educationLevels EducationLevel[]
  levels          Level[]
  subjects        Subject[]
  rooms           Room[]
  /// Towns the school writes on paperwork — birthplaces, previous schools —
  /// and the quartiers within them.
  cities          City[]
  neighbourhoods  Neighbourhood[]
  /// Denormalised back-reference; a class always belongs to one of this school's
  /// years. See the invariant note on SchoolClass.schoolId.
  classes         SchoolClass[]
  /// The kinds of evaluation this school runs, and every paper set under them.
  assessmentTypes AssessmentType[]
  assessments     Assessment[]
  /// The report cards issued here. See prisma/schema/bulletins/.
  bulletins       Bulletin[]
  /// What the school can charge. How much, per year, is FeeRate.
  feeTypes        FeeType[]

  // ── Vie scolaire ──────────────────────────────────────────────────────────
  /// Dossiers familiaux and the children on the books. Both are identity only;
  /// what a child does in a given year is an Enrollment, reached through it.
  families Family[]
  students Student[]

  // ── Logistique ────────────────────────────────────────────────────────────
  /// The fleet. Year-independent: what each bus does in a given year is a
  /// TransportRoute. See prisma/schema/transport/.
  vehicles     Vehicle[]
  /// What the fleet has been fuelled with, and who asked. Year-independent for
  /// the same reason the buses are.
  fuelRequests FuelRequest[]

  /// Days its teachers are away — see prisma/schema/timetable/teacher-absence.prisma.
  teacherAbsences TeacherAbsence[]
  /// Listes de fournitures, once approved — see prisma/schema/supplies/.
  supplyLists     SupplyList[]
  supplyArticles  SupplyArticle[]
  documentTypes   DocumentType[]

  // ── RH ────────────────────────────────────────────────────────────────────
  /// Everybody on the payroll. Year-independent, like the fleet: an employee is
  /// employed across school years, and what they were paid in a given month is
  /// a SalaryPayment. See prisma/schema/hr/.
  staff Staff[]

  /// Who may teach what here — see prisma/schema/hr/teacher-subject.prisma.
  teacherSubjects TeacherSubject[]

  // ── Caisse ────────────────────────────────────────────────────────────────
  /// The tills the school collects at, what it spends under, and every movement
  /// of money either way. See prisma/schema/treasury/.
  cashRegisters       CashRegister[]
  cashOperations      CashOperation[]
  /// The chart the caisse posts against, and the banks it deals with. See
  /// prisma/schema/treasury/operation-category.prisma.
  banks               Bank[]
  operationCategories OperationCategory[]
  operationMotifs     OperationMotif[]
  suppliers           Supplier[]
  payments            Payment[]
  cheques             Cheque[]

  /// What the school announces to its families — see modules/events.
  events Event[]

  /// The parents' conversations — see modules/chat.
  chatChannels ChatChannel[]

  @@unique([organizationId, code])
  /// No two schools may map to the same establishment. Many may be unmapped.
  @@unique([organizationId, massarCode])
  @@index([organizationId])
  @@map("schools")
}
