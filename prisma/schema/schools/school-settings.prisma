/// The policies a school sets for itself — the decisions that are neither
/// identity (which live on School) nor a list of rows (which live in the
/// configuration tables).
///
/// A grading scale out of 20, a pass at 10, a six-day week, a matricule that
/// starts with "E", nine instalments due on the 5th: every one of those is a
/// convention, not a fact, and every one of them was a constant in the code
/// before this table existed. Putting them here is what lets two schools in the
/// same organisation disagree.
///
/// ── Why every column has a default ──────────────────────────────────────────
/// The defaults are exactly the constants they replaced, and a school with no
/// row behaves precisely as it did before. `settingsOf` in modules/schools/
/// settings.ts falls back to the same values, so nothing in the app has to ask
/// whether the row exists — which is what made this safe to introduce across
/// fourteen call sites at once.
///
/// One row per school, created with the school and deleted with it. Not a
/// key-value bag: typed columns mean a typo in a setting name is a compile
/// error rather than a silently ignored write.
model SchoolSettings {
  id       String @id @default(cuid()) @db.VarChar(30)
  schoolId String @unique
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  // ── Notation ──────────────────────────────────────────────────────────────
  /// What a paper is marked out of by default. Moroccan schools use 20; a
  /// private school marking out of 10 or 100 changes it here and every new
  /// assessment, the mark sheet's validation and the pass colouring follow.
  gradingMaxScore Int @default(20)

  /// The pass mark, in basis points of `gradingMaxScore` — 5000 is a half, so
  /// 10/20. Basis points rather than a score so the threshold survives a change
  /// of scale, and rather than a float because this is the number that decides
  /// whether a child passed. Matches `discountBps` and `percentBps` elsewhere.
  passMarkBps Int @default(5000)

  // ── Calendrier ────────────────────────────────────────────────────────────
  /// The days this school teaches, as ISO weekday numbers joined by commas
  /// ("1,2,3,4,5,6" is Monday to Saturday). MySQL has no array type, and a
  /// join table for at most seven small integers earns nothing.
  ///
  /// Read through `parseTeachingDays`, which drops anything outside 1–7 — a
  /// hand-edited row must not be able to put an eighth column on a timetable.
  teachingDays String @default("1,2,3,4,5,6")

  // ── Monnaie et langue ─────────────────────────────────────────────────────
  /// ISO 4217. Amounts are stored in the currency's minor unit throughout
  /// (centimes for MAD), so changing this changes the label, never the maths.
  currencyCode String @default("MAD")

  /// The language new users of this school start in, and what a printed
  /// document falls back to. A user's own choice always wins — see Profile.
  defaultLocale String @default("fr")

  /// The accent new users of this school start with, so a school can put its
  /// own colour in front of everybody without taking the choice away. Allowed
  /// values live in modules/appearance/enums.ts.
  defaultAccent String @default("blue")

  // ── Matricules ────────────────────────────────────────────────────────────
  /// Templates for the generated references, e.g. "E-{year}-{seq:4}".
  ///
  /// Placeholders: `{year}` (4-digit), `{yy}` (2-digit), `{seq}` and `{seq:N}`
  /// (the sequence, zero-padded to N). Everything else is copied through, so a
  /// school that writes its matricules "2025/0431" simply says so. Rendered by
  /// `formatEntityCode`; the uniqueness constraint is still on the column, so a
  /// format that collides is refused at the database rather than silently
  /// overwriting.
  studentCodeFormat String @default("E-{year}-{seq:4}")
  familyCodeFormat  String @default("F-{year}-{seq:4}")
  staffCodeFormat   String @default("P-{year}-{seq:4}")

  // ── Facturation ───────────────────────────────────────────────────────────
  /// How many instalments a year's fees are split into when the fee rate does
  /// not say.
  ///
  /// **Zero means "as many months as the school year has"**, which is the
  /// default: a fixed nine was right for a September–June year and wrong for
  /// every other shape, and it cut a twelve-month year's fee grid off three
  /// months early with nothing on screen to say why. A school that collects a
  /// fixed number regardless of the calendar sets it here.
  /// See `defaultInstalmentCount` in modules/enrolment/enums.ts.
  defaultInstalmentCount Int @default(0)

  // ── Espace parents ────────────────────────────────────────────────────────
  /// Whether parents may use the school-wide conversation.
  ///
  /// Off by default, and deliberately: a parents' group is a thing a school
  /// decides to open, not something it discovers it has. Both switches are the
  /// manager's, on the Configuration screen — see modules/chat.
  parentChatEnabled Boolean @default(false)

  /// Whether each class gets a conversation between its own parents.
  ///
  /// Separate from the one above because the split is real: plenty of schools
  /// want a class group for one year-group and no school-wide one, where
  /// anybody's argument reaches everybody.
  parentClassChatEnabled Boolean @default(false)

  /// Day of the month an instalment falls due. Clamped to 1–28 so it exists in
  /// February — a schedule that skips a month once every four years is worse
  /// than one that is always on the 28th.
  feeDueDayOfMonth Int @default(5)

  // ── La sonnerie ───────────────────────────────────────────────────────────
  /// How long one period rings for, in minutes.
  ///
  /// An hour is what a Moroccan school actually teaches in, and it is what the
  /// grid should show: sixteen half-hour columns is a table nobody can read,
  /// and a 30-minute lesson is not a thing anybody timetables.
  ///
  /// The half hour that *does* matter is the **start** — see `dayStartsAt`. A
  /// school opening at 08h30 wants its whole day shifted, not its periods
  /// halved, and those are two different settings.
  periodMinutes Int @default(60)

  /// When the morning session begins, `HH:MM`.
  ///
  /// This is the shift. 08h00, 08h30, 09h00 and 09h30 are all ordinary, and
  /// every period of the morning follows from it — which is why it is one
  /// setting rather than a bell schedule somebody retypes.
  dayStartsAt String @default("08:00")

  /// When the afternoon session begins, after the lunch break.
  afternoonStartsAt String @default("14:00")

  /// Teaching periods before the récréation, in each session. The break falls
  /// after them and lasts `breakMinutes`.
  periodsBeforeBreak Int @default(2)
  breakMinutes       Int @default(15)

  /// Teaching periods in each session, the récréation aside.
  morningPeriods   Int @default(4)
  afternoonPeriods Int @default(4)

  /// The half-days the school teaches no afternoon, as ISO weekday numbers
  /// joined by commas — "3" for a free Wednesday afternoon, "5" for Friday,
  /// "3,6" for a school that also stops at noon on Saturday. Empty teaches
  /// every afternoon of every teaching day. Read through `parseWeekdayList`.
  ///
  /// Distinct from `teachingDays`, which says whether the school opens at all:
  /// a Wednesday with a free afternoon is still a teaching day, and dropping it
  /// from `teachingDays` would take its morning with it.
  ///
  /// A **list**, and never a rule about one named day. It began as a single
  /// `freeAfternoonDay` beside a `saturdayMorningOnly` switch, which is two
  /// mechanisms for one fact and neither of them the school's own choice: a
  /// school taking Friday afternoon for the prière had to leave Saturday to a
  /// hard-coded switch, and that switch was not stored at all — the grid lost
  /// its Saturday afternoons while this column said the week was whole.
  freeAfternoonDays String @default("")

  // ── Paie ──────────────────────────────────────────────────────────────────
  /// The divisor that turns a monthly salary into a daily rate. A convention
  /// (26 is the common Moroccan one), which is exactly why it is a setting: the
  /// figure it produces is shown beside the retenue box as a suggestion and is
  /// never applied automatically. See modules/hr/enums.ts.
  payrollWorkingDays Int @default(26)

  /// Cotisations salariales and the tax withheld, as rates the school sets.
  ///
  /// ── Why these are suggestions and not a calculator ──────────────────────
  /// They fill the CNSS, AMO and IR boxes on a bulletin so a bursar is not
  /// typing four figures from a table every month. They are *not* a payroll
  /// engine: the rates change by decree, a school may be on a different
  /// convention collective, and — most of all — the Moroccan IR is a
  /// progressive barème with a deduction per dependant, which a single rate
  /// cannot express. Every suggested figure is written into an editable box and
  /// the bursar remains the one who says what is withheld.
  ///
  /// Basis points throughout, for the same reason `passMarkBps` is: a rate that
  /// decides what somebody is paid must not be a float.
  ///
  /// Defaults are the ordinary Moroccan employee shares: CNSS 4.48% capped at
  /// 6 000 MAD a month, AMO 2.26% uncapped. IR defaults to zero, because a flat
  /// rate would be wrong for everybody and a zero is honestly blank.
  cnssRateBps         Int @default(448)
  /// The monthly plafond CNSS is computed on, in centimes. 0 means uncapped.
  cnssCeilingCentimes Int @default(600000)
  amoRateBps          Int @default(226)
  irRateBps           Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("school_settings")
}
