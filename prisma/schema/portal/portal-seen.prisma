/// How far through each part of the app an account has read.
///
/// ── Why a watermark and not a notification table ────────────────────────────
/// The obvious design is a row per notification. It is also the wrong one here:
/// every thing a parent could be told about — a published event, a mark, a
/// remark, a message — is already a row with a timestamp, and copying each one
/// into a second table means two records of the same fact that can disagree,
/// plus a fan-out write on every publish for every family in the school.
///
/// So nothing is written when something happens. One row per account per topic
/// records when they last looked, and "what is new" is a count of rows newer
/// than that — which the indexes those tables already carry can answer.
///
/// The cost is that this cannot say *which* three marks are new, only that
/// three are. That is exactly what a badge needs, and the screen behind it
/// shows the items in date order anyway.
///
/// Where that cost bites — an inbox with a message in it, and staff being told
/// about work that is not a row any family may read — there *is* a row per
/// recipient, in `Notification`. The two are deliberately separate and neither
/// derives from the other: this stays the family space's badge.
model PortalSeen {
  id     String @id @default(cuid()) @db.VarChar(30)
  userId String @db.VarChar(30)
  user   User   @relation("PortalSeen", fields: [userId], references: [id], onDelete: Cascade)

  /// "EVENTS" | "CHAT" | "MARKS" | "REMARKS" — see modules/portal/enums.ts.
  topic String

  /// When this account last opened that part of the app.
  seenAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, topic])
  @@index([userId])
  @@map("portal_seen")
}
