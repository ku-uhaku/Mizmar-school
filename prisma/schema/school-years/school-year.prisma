/// An academic year, owned by a school so each school can run its own calendar.
model SchoolYear {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  /// Display label, e.g. "2025-2026".
  name      String
  startDate DateTime
  endDate   DateTime
  /// "PLANNED" | "ACTIVE" | "CLOSED" — see modules/school-years/enums.ts
  status    String   @default("PLANNED")
  /// Exactly one year per school may be the default; enforced in the service layer.
  isDefault Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usersInContext User[] @relation("UserCurrentSchoolYear")

  /// Semesters, the bell schedule and the levels actually opened this year.
  terms          Term[]
  timeSlots      TimeSlot[]
  levelOfferings LevelOffering[]
  /// When the school does not teach — see prisma/schema/timetable/school-holiday.prisma.
  holidays       SchoolHoliday[]
  /// What each class is asked to bring this year.
  supplyLists    SupplyList[]

  /// This year's price list and the reductions offered against it.
  feeRates  FeeRate[]
  discounts Discount[]

  /// The pupils inscribed for this year.
  enrollments Enrollment[]

  /// Money collected against this year. Restrict on the other side: a year with
  /// receipts against it is closed history.
  payments Payment[]

  /// This year's bus lines and the runs they make.
  transportRoutes    TransportRoute[]
  transportSchedules TransportSchedule[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("school_years")
}
