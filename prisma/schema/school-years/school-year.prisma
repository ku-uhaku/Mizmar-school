/// An academic year, owned by a school so each school can run its own calendar.
model SchoolYear {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  /// Display label, e.g. "2025-2026".
  name      String
  startDate DateTime
  endDate   DateTime
  /// "PLANNED" | "ACTIVE" | "CLOSED" — see modules/school-years/enums.ts
  status    String   @default("PLANNED")
  /// Exactly one year per school may be the default; enforced in the service layer.
  isDefault Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usersInContext User[] @relation("UserCurrentSchoolYear")

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("school_years")
}
