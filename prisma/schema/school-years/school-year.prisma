/// An academic year, owned by a school so each school can run its own calendar.
model SchoolYear {
  id       String @id @default(cuid()) @db.VarChar(30)
  schoolId String @db.VarChar(30)
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  /// Display label, e.g. "2025-2026".
  name      String
  startDate DateTime
  endDate   DateTime
  /// "PLANNED" | "ACTIVE" | "CLOSED" — see modules/school-years/enums.ts
  status    String   @default("PLANNED")
  /// Exactly one year per school may be the default; enforced in the service layer.
  isDefault Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usersInContext User[] @relation("UserCurrentSchoolYear")

  /// Semesters, the bell schedule and the levels actually opened this year.
  terms          Term[]
  timeSlots      TimeSlot[]
  levelOfferings LevelOffering[]
  /// This year's programme: what each niveau is taught, weighted and timetabled
  /// for this year only — see prisma/schema/academics/level-subject.prisma.
  levelSubjects  LevelSubject[]
  /// When the school does not teach — see prisma/schema/timetable/school-holiday.prisma.
  holidays       SchoolHoliday[]
  /// What each class is asked to bring this year.
  supplyLists    SupplyList[]

  /// This year's price list and the reductions offered against it.
  feeRates  FeeRate[]
  discounts Discount[]

  /// The pupils inscribed for this year.
  enrollments Enrollment[]

  /// Money collected against this year. Restrict on the other side: a year with
  /// receipts against it is closed history.
  payments Payment[]

  /// The weeks the school teaches in, numbered — see
  /// prisma/schema/timetable/school-week.prisma.
  schoolWeeks SchoolWeek[]

  /// Who may take what this year — the staffing plan the timetable generator
  /// reads. See prisma/schema/hr/teacher-subject.prisma.
  teacherSubjects TeacherSubject[]
  staffOversight  StaffOversight[]

  /// This year's bus lines and the runs they make.
  transportRoutes    TransportRoute[]
  transportSchedules TransportSchedule[]

  /// This year's announcements. Scoped to the year so last year's calendar
  /// keeps resolving after this year's is drawn up.
  events Event[]

  /// This year's parent channels. Scoped to the year so last year's
  /// conversation stops appearing when this year's classes are drawn up.
  chatChannels ChatChannel[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("school_years")
}
