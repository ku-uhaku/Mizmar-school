/// An abonnement: one pupil riding one line, from one stop, for one year.
///
/// ── Why it hangs off the Enrollment, not the Student ────────────────────────
/// Riding the bus is a year-shaped fact, exactly like the class the child sits
/// in and the fees they are charged — see the note on Enrollment. A family moves
/// house and changes circuit between years; a child rides in 4AP and walks in 5AP.
/// Attaching this to the pupil would flatten all of that into one mutable row
/// and lose last year's arrangement the moment this year's was entered.
///
/// It also means the year and the school come for free, through the enrolment,
/// so a subscription can never point at a line from a different year.
///
/// ── What it does to the bill: nothing ───────────────────────────────────────
/// Transport is charged once, at enrolment, from the price list — the same flat
/// fee for every rider however far they live. Putting a child on a circuit is an
/// operational act and never rewrites an échéancier; all it does is set
/// `Enrollment.usesTransport`, which is the flag the schedule was already built
/// from. Nothing here is ever summed to work out a balance; that is the
/// enrolment's job and the caisse's.
model TransportSubscription {
  id           String     @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  /// Restrict: a line with passengers cannot be dropped without moving them
  /// first — deleting it would silently take children off the bus.
  routeId String
  route   TransportRoute @relation(fields: [routeId], references: [id], onDelete: Restrict)

  /// Where they board. Restrict for the same reason.
  stopId String
  stop   RouteStop @relation(fields: [stopId], references: [id], onDelete: Restrict)

  /// "MORNING" | "AFTERNOON" | "BOTH" — see modules/transport/enums.ts.
  /// A child taken to school by the bus and collected by a parent is ordinary,
  /// and is charged differently by most schools.
  direction String @default("BOTH")

  /// Which run of the line they are on — see
  /// prisma/schema/transport/transport-schedule.prisma.
  ///
  /// Nullable, and deliberately: a line that makes one run needs no answer, and
  /// every abonnement taken before the horaires were declared is still a valid
  /// abonnement. SetNull rather than Restrict: retiring a run must leave the
  /// child on the bus for somebody to re-seat, not refuse the change.
  ///
  /// INVARIANT (service layer): must be a run the subscribed route actually
  /// makes, i.e. a RouteSchedule row must join the two. Not expressible as a
  /// foreign key, so `subscribeRider` re-derives it rather than trusting it.
  scheduleId String?
  schedule   TransportSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  /// "ACTIVE" | "SUSPENDED" | "CANCELLED" — see modules/transport/enums.ts.
  /// SUSPENDED is the family that stops for a term and comes back; CANCELLED is
  /// the one that leaves the bus for good. Kept apart because the first keeps
  /// its seat and the second frees it.
  status String @default("ACTIVE")

  startsOn DateTime  @default(now())
  endsOn   DateTime?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// L'appel du bus for this rider — see
  /// prisma/schema/transport/transport-attendance.prisma.
  attendance TransportAttendance[]

  /// Mirror of `scheduleId`, so the unique index below actually distinguishes
  /// two named runs in the same half of the day — SQLite treats NULLs as
  /// distinct, so `[enrollmentId, direction]` alone let a line with a midday
  /// return and a separate afternoon pickup, both tagged AFTERNOON, take only
  /// one of them. A run that was named wins outright; a line with no horaire
  /// declared falls back to the direction, which is the single-departure case
  /// `scheduleId` is null for. See lib/db-keys.ts and
  /// `subscriptionScopeKey` in modules/transport/enums.ts.
  ///
  /// INVARIANT (service layer): always `subscriptionScopeKey(direction,
  /// scheduleId)`, recomputed on every write that touches either column.
  scopeKey String

  /// One subscription per run per enrolment — a pupil boards the 07:00 and the
  /// 12:00 as two abonnements, both perfectly ordinary on a school that sends
  /// children home for lunch. A line with no horaire declared falls back to one
  /// row per direction, which is what a single-departure line still needs.
  @@unique([enrollmentId, scopeKey])
  @@index([enrollmentId])
  @@index([routeId])
  @@index([stopId])
  @@index([scheduleId])
  @@index([routeId, status])
  @@map("transport_subscriptions")
}
