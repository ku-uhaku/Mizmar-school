/// L'appel du bus: whether one pupil boarded, on one run, on one day.
///
/// ── Why it is not StudentAttendance ─────────────────────────────────────────
/// The classroom register answers "was the child in the lesson", is keyed to a
/// TimeSlot of the bell schedule, and is taken by whoever is teaching. This
/// answers "did the child get on the bus", is keyed to a *run*, and is taken by
/// the driver or the accompagnateur at the kerb. Forcing this onto
/// StudentAttendance would have meant inventing a fake TimeSlot for every
/// departure, and would have made a child who missed the bus read as having
/// missed a lesson they may well have attended — plenty of families drive in
/// after the bus has gone.
///
/// The two registers are deliberately not wired to each other. A pupil absent
/// from the bus is not thereby absent from school, and the vie scolaire's
/// absence counts must not silently gain the mornings a parent drove them in.
///
/// ── Why it hangs off the subscription ───────────────────────────────────────
/// The abonnement is what says this child rides this line from this stop this
/// year — so a row cannot exist for somebody who is not on the bus, exactly as
/// StudentAttendance's enrolment key stops a mark for a pupil off the roster.
/// Cascade follows from that: taking a child off the bus for good removes the
/// record of them riding it, which is the same call `TransportSubscription`
/// already makes about its own history.
model TransportAttendance {
  id             String                @id @default(cuid()) @db.VarChar(30)
  subscriptionId String                @db.VarChar(30)
  subscription   TransportSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  /// Midnight of the day being marked. The time of day is carried by the run,
  /// never by this column, so two marks for one day always compare equal — the
  /// same rule StudentAttendance.date follows.
  date DateTime

  /// Which departure. Null when the line makes only one and none has been
  /// declared, which is why `scopeKey` below exists.
  /// SetNull: re-drawing the timetable must not delete last term's absences.
  scheduleId String?            @db.VarChar(30)
  schedule   TransportSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  /// "PRESENT" | "LATE" | "ABSENT" | "EXCUSED" — see RIDER_ATTENDANCE_STATUSES
  /// in modules/transport/enums.ts.
  status String @default("PRESENT")

  /// Minutes the bus was kept waiting, for LATE only.
  ///
  /// Kept rather than folded into the status because on a bus a retard is not a
  /// small absence — it is thirty other children arriving late too, and the
  /// figure is what a school acts on when it accumulates.
  minutesLate Int?

  /// Why, when somebody has said — "parti avec sa mère", "malade".
  reason String? @db.Text

  /// Whether the family warned the school. Apart from the status because
  /// "absent, mother rang the office" and "absent, nobody knows" are the same
  /// mark and very different problems for the driver at the kerb.
  isJustified Boolean @default(false)

  /// Who marked it. SetNull rather than Restrict, as on StudentAttendance: a
  /// register outlives the account of the person who took it.
  recordedById String? @db.VarChar(30)
  recordedBy   User?   @relation("BusRegisterRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Mirrors the nullable `scheduleId` so the unique index below actually
  /// fires — MySQL treats NULLs as distinct, so without it a pupil could be
  /// marked twice for the same departure and counted absent twice. See
  /// lib/db-keys.ts.
  ///
  /// INVARIANT: always `busRegisterScopeKey(scheduleId)` from
  /// modules/transport/enums.ts.
  scopeKey String

  /// One mark per rider per run per day. Re-marking corrects it rather than
  /// stacking a second opinion on top.
  @@unique([subscriptionId, date, scopeKey])
  @@index([subscriptionId])
  @@index([scheduleId])
  @@index([recordedById])
  @@index([date])
  @@map("transport_attendance")
}
