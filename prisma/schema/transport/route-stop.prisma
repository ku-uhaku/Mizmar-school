/// An arrêt: one point on a line, in the order the bus reaches it.
///
/// Purely operational — it says where the bus stops and when, and nothing about
/// money. Transport is charged once, at enrolment, from the price list, and no
/// stop or quartier changes that figure. It used to carry a pricing zone; the
/// school charges one flat transport fee, so the zone was a second answer to a
/// question the échéancier had already settled.
model RouteStop {
  id      String         @id @default(cuid())
  routeId String
  route   TransportRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)

  name   String
  nameAr String?

  /// What to look for: "devant la pharmacie", "rond-point".
  landmark String?

  /// The quartier this stop stands in. Nullable because a line drawn before the
  /// quartiers were listed still has its stops, and because a stop on a trunk
  /// road may genuinely be in none of them.
  /// Restrict: a quartier with stops in it cannot be deleted from under them.
  neighbourhoodId String?
  neighbourhood   Neighbourhood? @relation(fields: [neighbourhoodId], references: [id], onDelete: Restrict)

  /// Order along the line, from the first pick-up to the school.
  ///
  /// Not unique with `routeId`: reordering stops would otherwise need a
  /// temporary value to swap two rows past the constraint, and an index is
  /// enough for a list that is read in order and written whole.
  position Int @default(0)

  /// Scheduled times, as plain strings in "HH:MM".
  ///
  /// Not DateTime: these are times of day repeated every school day, and a
  /// DateTime would force an arbitrary date onto them that somebody would
  /// eventually read as meaningful. The timetable module stores its slots the
  /// same way.
  pickupTime  String?
  dropoffTime String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions TransportSubscription[]

  /// One stop of a given name per line — two "Pharmacie" stops on one route is
  /// a data-entry slip, and the secretary picking between them is a coin toss.
  @@unique([routeId, name])
  @@index([routeId])
  @@index([neighbourhoodId])
  @@map("route_stops")
}
