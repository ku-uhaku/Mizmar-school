/// A vehicle in the school's fleet — a bus, a minibus, the van that does the
/// small runs.
///
/// Declared per school and **year-independent**, exactly as FeeType is: a bus is
/// a bus across school years, and what it is used for this year is a
/// TransportRoute pointing at it. That split is what lets a fleet be carried
/// into a new year without being re-entered.
///
/// The two expiry dates are the reason a school keeps this list at all. A bus
/// whose visite technique lapsed is a bus that may not legally carry children,
/// and the date is the sort of thing nobody remembers until the gendarmerie
/// asks — so the fleet screen sorts on them and flags what is close.
model Vehicle {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  /// Matricule, as written on the plate: "12345-A-6".
  registration String

  make  String?
  model String?
  /// Year of first registration — mise en circulation.
  modelYear Int?

  /// Seats available to pupils, which is not always the seats in the vehicle.
  seatCount Int

  /// "ACTIVE" | "MAINTENANCE" | "RETIRED" — see modules/transport/enums.ts.
  status String @default("ACTIVE")

  /// Assurance and visite technique. Nullable because a school entering its
  /// fleet on a Tuesday afternoon should not be blocked on finding the papers.
  insuranceExpiresOn  DateTime?
  inspectionExpiresOn DateTime?

  /// The driver, when they are on the school's own payroll.
  ///
  /// SetNull: an employee leaving must leave the bus standing so somebody can
  /// put another driver on it, not delete the vehicle and its routes.
  driverId String?
  driver   Staff?  @relation("VehicleDriver", fields: [driverId], references: [id], onDelete: SetNull)

  /// The driver as free text, for the ones who are not employees.
  ///
  /// Kept alongside the relation rather than replaced by it, because a school's
  /// buses are as often a contractor's as its own — and the two things somebody
  /// needs when a bus has not arrived are a name and a phone number, whoever
  /// signs the driver's payslip. `driverLabel` in modules/transport/enums.ts is
  /// what decides which of the two to show, so no screen has to. Same decision
  /// as CashOperation.beneficiaryName.
  driverName  String?
  driverPhone String?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  routes TransportRoute[]

  @@unique([schoolId, registration])
  @@index([schoolId])
  @@index([driverId])
  @@index([schoolId, status])
  @@map("vehicles")
}
