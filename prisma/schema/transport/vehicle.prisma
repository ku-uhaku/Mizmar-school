/// A vehicle in the school's fleet — a bus, a minibus, the van that does the
/// small runs.
///
/// Declared per school and **year-independent**, exactly as FeeType is: a bus is
/// a bus across school years, and what it is used for this year is a
/// TransportRoute pointing at it. That split is what lets a fleet be carried
/// into a new year without being re-entered.
///
/// The two expiry dates are the reason a school keeps this list at all. A bus
/// whose visite technique lapsed is a bus that may not legally carry children,
/// and the date is the sort of thing nobody remembers until the gendarmerie
/// asks — so the fleet screen sorts on them and flags what is close.
model Vehicle {
  id       String @id @default(cuid()) @db.VarChar(30)
  schoolId String @db.VarChar(30)
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  /// Matricule, as written on the plate: "12345-A-6".
  registration String

  make      String?
  model     String?
  /// Year of first registration — mise en circulation.
  modelYear Int?

  /// Seats available to pupils, which is not always the seats in the vehicle.
  seatCount Int

  /// "ACTIVE" | "MAINTENANCE" | "RETIRED" — see modules/transport/enums.ts.
  status String @default("ACTIVE")

  /// Assurance and visite technique. Nullable because a school entering its
  /// fleet on a Tuesday afternoon should not be blocked on finding the papers.
  insuranceExpiresOn  DateTime?
  inspectionExpiresOn DateTime?

  /// The driver, when they are on the school's own payroll.
  ///
  /// SetNull: an employee leaving must leave the bus standing so somebody can
  /// put another driver on it, not delete the vehicle and its routes.
  driverId String? @db.VarChar(30)
  driver   Staff?  @relation("VehicleDriver", fields: [driverId], references: [id], onDelete: SetNull)

  /// The driver as free text, for the ones who are not employees.
  ///
  /// Kept alongside the relation rather than replaced by it, because a school's
  /// buses are as often a contractor's as its own — and the two things somebody
  /// needs when a bus has not arrived are a name and a phone number, whoever
  /// signs the driver's payslip. `driverLabel` in modules/transport/enums.ts is
  /// what decides which of the two to show, so no screen has to. Same decision
  /// as CashOperation.beneficiaryName.
  driverName  String?
  driverPhone String?

  /// L'accompagnateur: whoever rides with the children and takes the appel at
  /// the kerb while the driver stays at the wheel.
  ///
  /// On the bus rather than on the line, exactly as the driver is: a school that
  /// swaps a circuit onto another vehicle swaps its crew with it, and the pair
  /// is what a parent is given when the bus has not arrived.
  ///
  /// Load-bearing on the phone: `listMyRuns` matches an account against both
  /// this and `driverId`, so an accompagnateur signing in sees the same voyages
  /// as the driver and may take the same register. Nothing else follows from it
  /// — the appel is behind TRANSPORT_ATTENDANCE, and this column grants no
  /// permission of its own.
  ///
  /// SetNull, for the reason `driverId` is: an employee leaving must leave the
  /// bus standing so somebody else can be put on it.
  attendantId String? @db.VarChar(30)
  attendant   Staff?  @relation("VehicleAttendant", fields: [attendantId], references: [id], onDelete: SetNull)

  /// The accompagnateur as free text, for the ones who are not employees — the
  /// same arrangement, and the same reason, as `driverName`/`driverPhone`.
  attendantName  String?
  attendantPhone String?

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  routes TransportRoute[]

  /// Every tank of fuel drawn for it. Restrict on the other side: a bus with
  /// spending history against it is not deletable.
  fuelRequests FuelRequest[]
  /// Voyages this bus made. SetNull on the other side: retiring a bus must not
  /// erase the mornings it ran.
  tripRuns     TripRun[]

  @@unique([schoolId, registration])
  @@index([schoolId])
  @@index([driverId])
  @@index([attendantId])
  @@index([schoolId, status])
  @@map("vehicles")
}
