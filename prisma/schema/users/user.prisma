model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  email        String  @unique
  passwordHash String
  isActive     Boolean @default(true)
  /// Bypasses every permission check. Kept out of the role system on purpose so
  /// an org can never lock itself out by editing roles.
  isSuperAdmin Boolean @default(false)

  /// Organisation-wide role. Its permissions apply in every school.
  orgRoleId String?
  orgRole   Role?   @relation("UserOrgRole", fields: [orgRoleId], references: [id], onDelete: SetNull)

  /// The working context the user last selected. Persisted per user (not in a
  /// cookie) so it survives across devices and cannot be forged by the client.
  currentSchoolId String?
  currentSchool   School? @relation("UserCurrentSchool", fields: [currentSchoolId], references: [id], onDelete: SetNull)

  currentSchoolYearId String?
  currentSchoolYear   SchoolYear? @relation("UserCurrentSchoolYear", fields: [currentSchoolYearId], references: [id], onDelete: SetNull)

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  profile     Profile?
  memberships Membership[]

  // ── Teaching ──────────────────────────────────────────────────────────────
  /// Classes this user is professeur principal of.
  mainTeacherOf       SchoolClass[]        @relation("ClassMainTeacher")
  teachingAssignments TeachingAssignment[] @relation("TeacherAssignments")
  timetableEntries    TimetableEntry[]     @relation("TeacherTimetable")
  /// Periods of the week this teacher does not work. A hard constraint on the
  /// grid — see prisma/schema/timetable/teacher-unavailability.prisma.
  unavailability      TeacherUnavailability[] @relation("TeacherUnavailability")
  /// Days away, and the lessons somebody else covers — see
  /// prisma/schema/timetable/teacher-absence.prisma.
  absences            TeacherAbsence[]     @relation("TeacherAbsences")
  substitutions       TeacherAbsence[]     @relation("TeacherSubstitutions")
  /// One-off changes to a week's grid.
  timetableExceptions   TimetableException[] @relation("TeacherTimetableExceptions")
  authoredExceptions    TimetableException[] @relation("TimetableExceptionAuthor")
  /// Listes de fournitures written, and reviewed.
  supplyListsAuthored   SupplyList[]         @relation("SupplyListAuthor")
  supplyListsReviewed   SupplyList[]         @relation("SupplyListReviewer")
  /// Contrôles this user is answerable for, set, and has marked. SetNull on all
  /// three — a paper outlives the account that created it.
  assessmentsTeaching Assessment[]         @relation("TeacherAssessments")
  assessmentsAuthored Assessment[]         @relation("AssessmentAuthor")
  gradesEntered       AssessmentGrade[]    @relation("GradeAuthor")
  /// Registers taken and observations written in the classroom. SetNull on
  /// both: a register outlives the account that took it.
  pupilAttendance     StudentAttendance[]  @relation("AttendanceRecordedByTeacher")
  pupilRemarks        StudentRemark[]      @relation("RemarkAuthor")

  /// Portal accounts opened for parents. Almost always empty — a guardian is a
  /// row in the dossier familial, and only becomes a User if a school chooses
  /// to let them sign in.
  guardianProfiles Guardian[] @relation("GuardianAccount")

  // ── RH ────────────────────────────────────────────────────────────────────
  /// The employment record, when this account belongs to somebody on the
  /// payroll. Usually set, but never assumed: most of the payroll never signs
  /// in, and some accounts are not employees. See the note on Staff.userId.
  staffRecord Staff? @relation("StaffAccount")
  /// Registers marked and leave decided. Restrict and SetNull respectively —
  /// see the notes on those columns.
  attendanceRecorded StaffAttendance[] @relation("AttendanceRecordedBy")
  leaveDecisions     LeaveRequest[]    @relation("LeaveDecidedBy")

  // ── Caisse ────────────────────────────────────────────────────────────────
  /// Who held the drawer and who posted what. All Restrict on the other side:
  /// the ledger must always be able to name the person behind a movement.
  sessionsOpened    CashSession[]   @relation("SessionOpenedBy")
  sessionsClosed    CashSession[]   @relation("SessionClosedBy")
  operationsCreated CashOperation[] @relation("OperationCreatedBy")
  paymentsCreated   Payment[]       @relation("PaymentCreatedBy")

  // ── Logistique ────────────────────────────────────────────────────────────
  /// Fuel requests this account decided. SetNull on the other side: an approval
  /// must degrade to "by an account since removed" rather than block a leaver.
  fuelDecisions FuelRequest[] @relation("FuelRequestDecidedBy")
  /// Bus registers this account took. SetNull on the other side — a register
  /// outlives the account of whoever marked it.
  busRegistersTaken TransportAttendance[] @relation("BusRegisterRecordedBy")

  @@index([organizationId])
  @@map("users")
}
