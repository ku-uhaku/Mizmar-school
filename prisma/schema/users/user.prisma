model User {
  id             String       @id @default(cuid()) @db.VarChar(30)
  organizationId String       @db.VarChar(30)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// A mailbox for this person, when the school knows of one. Optional, and
  /// nothing signs in with it — see `username` below. A parent handed a portal
  /// login at the counter usually has no address the school holds, and a
  /// caretaker who needs the staff chat and nothing else has none either;
  /// inventing `parent.f2025-0142@famille.ma` to satisfy a NOT NULL only put a
  /// fiction in a column reports then printed.
  ///
  /// Unique where present, which is what nullable-unique means in MySQL: many
  /// accounts may have none, no two may share one.
  ///
  /// Always lowercase — the form lowercases it on the way in, so the unique
  /// index means what it looks like it means.
  email String? @unique

  /// What this account types to sign in. The only credential there is: the web
  /// form and the phone both ask for a username, and `checkCredentials` looks in
  /// this column and no other.
  ///
  /// ── Why it is required ──────────────────────────────────────────────────
  /// Every row in this table is a login — `passwordHash` is not nullable — so an
  /// account with no username is an account nobody can reach. It was nullable
  /// while a parent still signed in with their email address; once the email
  /// stopped being a credential, a NULL here stopped meaning "signs in
  /// elsewhere" and started meaning "locked out", which is not a state a form
  /// should be able to save.
  ///
  /// Always lowercase and always `USERNAME_PATTERN` — see modules/users/enums.ts.
  /// Suggested from the name when an account is created, and editable, so a
  /// school keeps a consistent shape without being unable to spell an awkward
  /// one.
  username String @unique

  passwordHash String
  isActive     Boolean @default(true)
  /// Bypasses every permission check. Kept out of the role system on purpose so
  /// an org can never lock itself out by editing roles.
  isSuperAdmin Boolean @default(false)

  /// Organisation-wide role. Its permissions apply in every school.
  orgRoleId String? @db.VarChar(30)
  orgRole   Role?   @relation("UserOrgRole", fields: [orgRoleId], references: [id], onDelete: SetNull)

  /// The working context the user last selected. Persisted per user (not in a
  /// cookie) so it survives across devices and cannot be forged by the client.
  currentSchoolId String? @db.VarChar(30)
  currentSchool   School? @relation("UserCurrentSchool", fields: [currentSchoolId], references: [id], onDelete: SetNull)

  currentSchoolYearId String?     @db.VarChar(30)
  currentSchoolYear   SchoolYear? @relation("UserCurrentSchoolYear", fields: [currentSchoolYearId], references: [id], onDelete: SetNull)

  /// When this account's password last changed. Every credential — the session
  /// cookie and both mobile tokens — carries the value that was current when it
  /// was issued, and lib/dal.ts refuses any credential older than this column.
  /// That is what makes resetting a compromised account's password actually
  /// evict the intruder: without it a stolen refresh token stayed good for its
  /// full 60 days and a reset changed nothing for whoever already had one.
  /// Null means the password has never been changed since the account was made.
  credentialsChangedAt DateTime?

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  profile     Profile?
  memberships Membership[]

  // ── Teaching ──────────────────────────────────────────────────────────────
  /// Classes this user is professeur principal of.
  mainTeacherOf       SchoolClass[]           @relation("ClassMainTeacher")
  teachingAssignments TeachingAssignment[]    @relation("TeacherAssignments")
  /// What this teacher may be given, as opposed to what they have been —
  /// see prisma/schema/hr/teacher-subject.prisma.
  subjectsQualified   TeacherSubject[]        @relation("TeacherSubjects")
  timetableEntries    TimetableEntry[]        @relation("TeacherTimetable")
  /// Periods of the week this teacher does not work. A hard constraint on the
  /// grid — see prisma/schema/timetable/teacher-unavailability.prisma.
  unavailability      TeacherUnavailability[] @relation("TeacherUnavailability")
  /// Days away, and the lessons somebody else covers — see
  /// prisma/schema/timetable/teacher-absence.prisma.
  absences            TeacherAbsence[]        @relation("TeacherAbsences")
  substitutions       TeacherAbsence[]        @relation("TeacherSubstitutions")
  /// One-off changes to a week's grid.
  timetableExceptions TimetableException[]    @relation("TeacherTimetableExceptions")
  authoredExceptions  TimetableException[]    @relation("TimetableExceptionAuthor")
  /// Listes de fournitures written, and reviewed.
  supplyListsAuthored SupplyList[]            @relation("SupplyListAuthor")
  documentsRecorded   StudentDocument[]       @relation("StudentDocumentRecorder")
  /// The till this person holds, if any — see CashRegister.holderId.
  cashRegisterHeld    CashRegister?           @relation("CashRegisterHolder")
  advancesApproved    SalaryAdvance[]         @relation("AdvanceApprover")
  supplyListsReviewed SupplyList[]            @relation("SupplyListReviewer")
  /// Contrôles this user is answerable for, set, and has marked. SetNull on all
  /// three — a paper outlives the account that created it.
  assessmentsTeaching Assessment[]            @relation("TeacherAssessments")
  assessmentsAuthored Assessment[]            @relation("AssessmentAuthor")
  gradesEntered       AssessmentGrade[]       @relation("GradeAuthor")
  /// Bulletins released to families. SetNull: the document outlives the
  /// account that released it, and who released it stays worth recording.
  bulletinsPublished  Bulletin[]              @relation("BulletinPublisher")
  /// Registers taken and observations written in the classroom. SetNull on
  /// both: a register outlives the account that took it.
  pupilAttendance     StudentAttendance[]     @relation("AttendanceRecordedByTeacher")
  pupilRemarks        StudentRemark[]         @relation("RemarkAuthor")
  /// Papers asked for from the phone, and papers dealt with at the desk.
  /// SetNull on both: a request already handled is a fact about the school's
  /// work and must survive the account that filed or answered it.
  documentRequests    DocumentRequest[]       @relation("DocumentRequestAuthor")
  requestsHandled     DocumentRequest[]       @relation("DocumentRequestHandler")

  /// Portal accounts opened for parents. Almost always empty — a guardian is a
  /// row in the dossier familial, and only becomes a User if a school chooses
  /// to let them sign in.
  guardianProfiles Guardian[] @relation("GuardianAccount")

  // ── RH ────────────────────────────────────────────────────────────────────
  /// The employment record, when this account belongs to somebody on the
  /// payroll. Usually set, but never assumed: most of the payroll never signs
  /// in, and some accounts are not employees. See the note on Staff.userId.
  staffRecord        Staff?            @relation("StaffAccount")
  /// Registers marked and leave decided. Restrict and SetNull respectively —
  /// see the notes on those columns.
  attendanceRecorded StaffAttendance[] @relation("AttendanceRecordedBy")
  leaveDecisions     LeaveRequest[]    @relation("LeaveDecidedBy")

  // ── Caisse ────────────────────────────────────────────────────────────────
  /// Who held the drawer and who posted what. All Restrict on the other side:
  /// the ledger must always be able to name the person behind a movement.
  sessionsOpened    CashSession[]     @relation("SessionOpenedBy")
  sessionsClosed    CashSession[]     @relation("SessionClosedBy")
  operationsCreated CashOperation[]   @relation("OperationCreatedBy")
  paymentsCreated   Payment[]         @relation("PaymentCreatedBy")
  reportFavourites  ReportFavourite[] @relation("ReportFavourites")
  feeLinesCancelled EnrollmentFee[]   @relation("FeeLineCancelledBy")
  /// SetNull on the other side, unlike the Restrict above: cancellations must
  /// outlive the cashier who made them, and the note explains itself.
  paymentsCancelled Payment[]         @relation("PaymentCancelledBy")
  /// Voyages this account started or closed. SetNull on the other side: a run
  /// outlives the driver whose account was later removed.
  tripRunsStarted   TripRun[]         @relation("TripRunStartedBy")
  tripRunsArrived   TripRun[]         @relation("TripRunArrivedBy")

  // ── Logistique ────────────────────────────────────────────────────────────
  /// Fuel requests this account decided. SetNull on the other side: an approval
  /// must degrade to "by an account since removed" rather than block a leaver.
  fuelDecisions     FuelRequest[]         @relation("FuelRequestDecidedBy")
  /// Bus registers this account took. SetNull on the other side — a register
  /// outlives the account of whoever marked it.
  busRegistersTaken TransportAttendance[] @relation("BusRegisterRecordedBy")

  eventsAuthored  Event[] @relation("EventAuthor")
  eventsPublished Event[] @relation("EventPublisher")

  chatMessages  ChatMessage[] @relation("ChatAuthor")
  chatModerated ChatMessage[] @relation("ChatModerator")

  portalSeen PortalSeen[] @relation("PortalSeen")

  /// The inbox — see modules/notifications. Cascade on the other side: nobody
  /// else may read them, so they have no meaning once the account is gone.
  notifications Notification[] @relation("NotificationRecipient")

  @@index([organizationId])
  @@map("users")
}
