/// A household — the dossier familial a school opens once and keeps for as long
/// as any of its children attend.
///
/// The family is the unit the school actually deals with: one address, one
/// phone that gets answered, one set of invoices, one sibling reduction. Its
/// members are split across two tables because they play different parts:
/// `Guardian` rows are the adults (père, mère, tuteur) and `Student` rows are
/// the children. Neither is a `User` — a parent has no account until someone
/// gives them one, and a child never signs in at all.
///
/// School-scoped rather than organisation-scoped, like everything else reachable
/// from the working context. A groupe scolaire whose siblings attend two of its
/// schools therefore keeps two dossiers; that is the price of every screen in
/// the app being confined to `context.currentSchool`, and it is the trade the
/// rest of the schema already makes.
model Family {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  /// Dossier number as written on the file, e.g. "F-2025-0142". Generated by
  /// the service layer when the form leaves it blank, so a secretary opening a
  /// dossier in a hurry still gets a stable reference.
  code String

  /// The family name as the school addresses it, e.g. "Famille Bennis".
  name   String
  nameAr String?

  /// "MARRIED" | "DIVORCED" | "WIDOWED" | "SEPARATED" | "OTHER"
  /// see modules/families/enums.ts. Recorded because it decides who may collect
  /// a child and who receives the paperwork, not out of curiosity.
  situation String @default("MARRIED")

  /// The household's contact details. A guardian may override any of them with
  /// their own — these are the fallback, and what an invoice is addressed to.
  addressLine String?
  city        String?
  postalCode  String?
  /// ISO 3166-1 alpha-2.
  country     String  @default("MA")
  phone       String?
  email       String?

  notes    String?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guardians Guardian[]
  children  Student[]

  /// Receipts made out to this household. One of them may settle several
  /// children at once — see prisma/schema/treasury/payment.prisma.
  payments Payment[]

  @@unique([schoolId, code])
  @@index([schoolId])
  @@index([schoolId, name])
  @@map("families")
}
