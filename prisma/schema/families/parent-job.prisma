/// La profession d'un parent: Enseignant, Commerçant, Fonctionnaire, Sans
/// emploi.
///
/// A lookup table for the same reason `StaffFunction` is one — and with a
/// second reason of its own. A dossier familial is read in aggregate: schools
/// are asked how many of their families are fonctionnaires, and a column where
/// one secretary typed "Prof.", another "Professeur" and a third "enseignant"
/// answers that question wrongly every time. Agreed once here.
///
/// School-scoped, so a school serving a rural commune keeps "Agriculteur" near
/// the top of its own list without the one downtown carrying it.
///
/// `isActive` rather than deletion, as everywhere: a profession that turns out
/// to be a duplicate stops being offered without rewriting the families that
/// already named it.
model ParentJob {
  id       String @id @default(cuid()) @db.VarChar(30)
  schoolId String @db.VarChar(30)
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  /// Short reference, e.g. "FONCT". What an import file keys the profession on.
  code String

  name   String
  /// The Arabic wording — a fiche de renseignements is filled in either
  /// language and has to read back in both.
  nameAr String?

  /// Where it sits in the picker. The handful a school records most often go
  /// first; alphabetical order buries them.
  position Int @default(0)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Restrict: a profession a guardian holds cannot be deleted out from under
  /// them. Deactivate it instead.
  guardians Guardian[]

  @@unique([schoolId, code])
  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("parent_jobs")
}
