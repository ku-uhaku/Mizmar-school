/// An élève: a child on the school's books.
///
/// A student row is *identity*, and nothing else. Which level, which class,
/// which group, what is billed and what has been paid all belong to one school
/// year, and therefore live on `Enrollment` — a child who repeats 3AP has two
/// enrolments and one student row, and last year's class list must keep
/// resolving after this year's is drawn up.
///
/// That split is what "a child has no place until it is enrolled" means here:
/// creating a student is opening a file, not seating anyone. `status` reports
/// where the file has got to, and the service layer moves it as enrolments come
/// and go — it is never typed in by hand.
///
/// Not a `User`. Children do not sign in, and `Membership` exists to grant
/// permissions, which a pupil holds none of.
model Student {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  /// The household. Nullable because a file is often opened from a phone call
  /// with only the child's name, and the dossier familial is completed after.
  /// SetNull rather than Cascade: deleting a family must not delete its
  /// children, whose marks and invoices outlive the dossier.
  familyId String?
  family   Family? @relation(fields: [familyId], references: [id], onDelete: SetNull)

  /// Matricule interne, e.g. "E-2025-0431". Generated by the service layer when
  /// left blank, so every child has a reference to write on a form.
  code String

  /// The pupil's code in MASSAR (منظومة مسار). Class lists and marks are filed
  /// nationally under it and it rarely matches the school's own `code`; null
  /// until an administrator maps the child. Nullable-unique is what we want
  /// here: many pupils may be unmapped, no two may claim the same code.
  massarCode String?

  /// MASSAR's own row number for the pupil — the "رقم التلميذ" in the hidden `B`
  /// column of a NotesCC export, e.g. "14162830".
  ///
  /// Not a duplicate of `massarCode`. The code (`R185066146`) is what a pupil is
  /// called on paper and what a secretary types; this is the surrogate key
  /// MASSAR joins on internally, and it is the column a mark sheet is keyed by.
  /// Both are needed: a returning file identifies its rows by this number, and a
  /// school that only ever mapped the printed code could not match them back.
  ///
  /// Kept as a String, not an Int. It is an opaque identifier issued elsewhere —
  /// nothing here counts or sums it, and a leading zero appearing in some future
  /// batch must not be eaten.
  massarNumber String?

  firstName   String
  lastName    String
  /// Arabic given and family name. Moroccan school paperwork — certificats de
  /// scolarité, relevés de notes, MASSAR itself — is issued in Arabic as well as
  /// French, and transliterating on the fly gets a child's name wrong.
  firstNameAr String?
  lastNameAr  String?

  /// "MALE" | "FEMALE" — see modules/students/enums.ts. Required: class lists,
  /// EPS groups and the ministry's own returns are all broken down by it.
  gender String

  /// Required, unlike a staff member's. Age decides which level a child may be
  /// admitted to, so a file cannot be opened without it.
  birthDate DateTime

  /// Where the child was born, picked from the school's list of towns rather
  /// than typed — see prisma/schema/geography/city.prisma. Both spellings come
  /// from the City row, so the Arabic half of a certificat de scolarité prints
  /// the same name every time. Restrict: a town cannot be deleted out from
  /// under the pupils born in it.
  birthCityId String?
  birthCity   City?   @relation("StudentBirthCity", fields: [birthCityId], references: [id], onDelete: Restrict)

  /// The quartier the family lives in — see
  /// prisma/schema/geography/neighbourhood.prisma.
  ///
  /// On the pupil rather than only on their abonnement, because it is asked at
  /// admission of *every* child and is true whether or not they take the bus:
  /// a walker's quartier is what an attestation de résidence prints, what a
  /// social case is grouped by, and what tells the school which circuits it
  /// would have to open to collect the families it is turning away. Holding it
  /// only on TransportSubscription made it unaskable until a child was seated
  /// on a line, which is backwards.
  ///
  /// It is also what pre-fills the inscription's transport cascade, so a
  /// secretary who has already typed the address is not asked for it twice.
  /// Restrict, like every other reference to the geography lists: a quartier
  /// with residents cannot be deleted out from under them.
  neighbourhoodId String?
  neighbourhood   Neighbourhood? @relation(fields: [neighbourhoodId], references: [id], onDelete: Restrict)

  /// ISO 3166-1 alpha-2.
  nationality String @default("MA")

  /// CNIE, for pupils old enough to hold one (16+). Distinct from `massarCode`:
  /// one is national identity, the other a school-system key.
  nationalId String?

  photoUrl String?

  /// "PRE_REGISTERED" | "ENROLLED" | "TRANSFERRED" | "WITHDRAWN" | "GRADUATED"
  /// see modules/students/enums.ts.
  ///
  /// INVARIANT (service layer): derived from the student's enrolments, never
  /// set from a form. See `refreshStudentStatus` in modules/students/service.ts.
  status String @default("PRE_REGISTERED")

  /// First arrival at this school, and departure. Not derivable from the
  /// enrolments alone: a child who transfers in mid-year has an entry date
  /// inside the year its enrolment starts.
  entryDate DateTime?
  exitDate  DateTime?

  /// ── Santé ──────────────────────────────────────────────────────────────
  ///
  /// Structured only where the infirmary reads the field on its own: a blood
  /// group is looked up in an emergency and a doctor's number is dialled, so
  /// neither may be buried in a paragraph. Everything nuanced stays in
  /// `medicalNotes` — a half-structured medical record is worse than prose.

  /// "A+" | "A-" | "B+" | "B-" | "AB+" | "AB-" | "O+" | "O-"
  /// see modules/students/enums.ts.
  bloodType String?

  /// What the child reacts to, and what happens. Kept apart from
  /// `medicalNotes` because it is the one line a supervising teacher is asked
  /// for before a trip or a canteen sitting.
  allergies String?

  /// Asthma, diabetes, epilepsy — a standing condition, as opposed to an
  /// allergy that is triggered.
  chronicCondition String?

  /// Treatment taken during school hours, with its dosage.
  medications String?

  /// The family's own doctor, called before the emergency services when there
  /// is time to choose.
  doctorName  String?
  doctorPhone String?

  /// Mutuelle, CNSS, AMO, private insurer — who is billed for a hospital visit.
  insurer String?

  /// Whether the child needs an accommodation (seating, extra time, access).
  /// A flag rather than free text because class lists and exam arrangements
  /// filter on it; the detail goes in `medicalNotes`.
  hasDisability Boolean @default(false)

  /// Allergies, treatments, anything the infirmary must know before an
  /// incident. Free text on purpose — a structured medical record is a
  /// different product, and a half-structured one is worse than a paragraph.
  medicalNotes String?

  /// ── Scolarité antérieure ───────────────────────────────────────────────
  ///
  /// Where the child was before this school, as declared at admission. Not an
  /// `Enrollment` — those are this school's years, and a transfer file records
  /// a history the school never kept. Free text because a certificat de
  /// scolarité from another établissement names a level this school may not
  /// even offer.
  previousSchool String?
  previousLevel  String?

  /// The town the previous school stood in — the same list as `birthCityId`.
  previousSchoolCityId String?
  previousSchoolCity   City?   @relation("StudentPreviousSchoolCity", fields: [previousSchoolCityId], references: [id], onDelete: Restrict)

  /// "PUBLIC" | "PRIVATE" | "MISSION" | "HOMESCHOOL" | "OTHER"
  /// see modules/students/enums.ts. Null for a child who has never been to
  /// school, which is the normal case in petite section.
  schoolingType String?

  /// Why the family moved the child. Asked at admission and read again when a
  /// pattern of transfers matters.
  transferReason String?

  /// ── Fratrie et foyer ───────────────────────────────────────────────────
  ///
  /// Held on the pupil rather than on `Family` so a file opened before its
  /// dossier familial still carries the answers, and a half-sibling's counts
  /// are not forced to match. The total is derived from the two, never stored.
  brotherCount Int?
  sisterCount  Int?

  /// Rang dans la fratrie — 1 for the eldest. Recorded because it is asked on
  /// every admission form and cannot be worked out from the counts.
  birthRank Int?

  /// "BOTH_PARENTS" | "MOTHER" | "FATHER" | "GUARDIAN" | "BOARDING" | "OTHER"
  /// see modules/students/enums.ts. Distinct from `Family.situation`: parents
  /// may be married and the child still boards with an aunt in term time.
  livesWith String?

  /// Pupille de la Nation and equivalents. A flag because it decides fee
  /// exemptions and paperwork, and because asking it as prose gets it missed.
  isOrphan Boolean @default(false)

  notes    String?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments Enrollment[]

  /// The dossier: which pièces the school has, and which it is still waiting
  /// for. Identity rather than a year's business — see StudentDocument.
  documents StudentDocument[]

  /// Papers the family has asked the school to issue about this child. The
  /// other direction entirely from the dossier above — see DocumentRequest.
  documentRequests DocumentRequest[]

  @@unique([schoolId, code])
  /// No two pupils may map to the same MASSAR code. Many may be unmapped.
  @@unique([schoolId, massarCode])
  /// Likewise for MASSAR's internal number — it is the key a mark sheet joins
  /// on, so two pupils sharing one would misfile a whole class's marks.
  @@unique([schoolId, massarNumber])
  @@index([schoolId])
  @@index([familyId])
  @@index([neighbourhoodId])
  @@index([birthCityId])
  @@index([previousSchoolCityId])
  @@index([schoolId, lastName])
  @@index([schoolId, status])
  @@map("students")
}
