/// An élève: a child on the school's books.
///
/// A student row is *identity*, and nothing else. Which level, which class,
/// which group, what is billed and what has been paid all belong to one school
/// year, and therefore live on `Enrollment` — a child who repeats 3AP has two
/// enrolments and one student row, and last year's class list must keep
/// resolving after this year's is drawn up.
///
/// That split is what "a child has no place until it is enrolled" means here:
/// creating a student is opening a file, not seating anyone. `status` reports
/// where the file has got to, and the service layer moves it as enrolments come
/// and go — it is never typed in by hand.
///
/// Not a `User`. Children do not sign in, and `Membership` exists to grant
/// permissions, which a pupil holds none of.
model Student {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  /// The household. Nullable because a file is often opened from a phone call
  /// with only the child's name, and the dossier familial is completed after.
  /// SetNull rather than Cascade: deleting a family must not delete its
  /// children, whose marks and invoices outlive the dossier.
  familyId String?
  family   Family? @relation(fields: [familyId], references: [id], onDelete: SetNull)

  /// Matricule interne, e.g. "E-2025-0431". Generated by the service layer when
  /// left blank, so every child has a reference to write on a form.
  code String

  /// The pupil's code in MASSAR (منظومة مسار). Class lists and marks are filed
  /// nationally under it and it rarely matches the school's own `code`; null
  /// until an administrator maps the child. Nullable-unique is what we want
  /// here: many pupils may be unmapped, no two may claim the same code.
  massarCode String?

  firstName String
  lastName  String
  /// Arabic given and family name. Moroccan school paperwork — certificats de
  /// scolarité, relevés de notes, MASSAR itself — is issued in Arabic as well as
  /// French, and transliterating on the fly gets a child's name wrong.
  firstNameAr String?
  lastNameAr  String?

  /// "MALE" | "FEMALE" — see modules/students/enums.ts. Required: class lists,
  /// EPS groups and the ministry's own returns are all broken down by it.
  gender String

  /// Required, unlike a staff member's. Age decides which level a child may be
  /// admitted to, so a file cannot be opened without it.
  birthDate    DateTime
  birthPlace   String?
  birthPlaceAr String?

  /// ISO 3166-1 alpha-2.
  nationality String @default("MA")

  /// CNIE, for pupils old enough to hold one (16+). Distinct from `massarCode`:
  /// one is national identity, the other a school-system key.
  nationalId String?

  photoUrl String?

  /// "PRE_REGISTERED" | "ENROLLED" | "TRANSFERRED" | "WITHDRAWN" | "GRADUATED"
  /// see modules/students/enums.ts.
  ///
  /// INVARIANT (service layer): derived from the student's enrolments, never
  /// set from a form. See `refreshStudentStatus` in modules/students/service.ts.
  status String @default("PRE_REGISTERED")

  /// First arrival at this school, and departure. Not derivable from the
  /// enrolments alone: a child who transfers in mid-year has an entry date
  /// inside the year its enrolment starts.
  entryDate DateTime?
  exitDate  DateTime?

  /// Allergies, treatments, anything the infirmary must know before an
  /// incident. Free text on purpose — a structured medical record is a
  /// different product, and a half-structured one is worse than a paragraph.
  medicalNotes String?

  notes    String?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments Enrollment[]

  @@unique([schoolId, code])
  /// No two pupils may map to the same MASSAR code. Many may be unmapped.
  @@unique([schoolId, massarCode])
  @@index([schoolId])
  @@index([familyId])
  @@index([schoolId, lastName])
  @@index([schoolId, status])
  @@map("students")
}
