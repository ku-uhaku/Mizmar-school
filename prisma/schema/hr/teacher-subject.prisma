/// What a teacher is qualified — and willing — to teach, in one school year.
///
/// ── Why this is not TeachingAssignment ──────────────────────────────────────
/// `TeachingAssignment` says *who teaches what to which class this year*. This
/// says *who could*. The difference is the whole reason the timetable generator
/// can fill a gap: a class with no maths teacher named is not a class nobody in
/// the building can teach maths to, and until this table existed the generator
/// had no way to tell the two apart. It drew grids with the teacher column
/// empty and left a head of studies to fill in two hundred cells by hand.
///
/// So the generator reads this to *make* the assignments, and writes the
/// `TeachingAssignment` rows it settles on. This is the input; that is the
/// decision.
///
/// ── Why it is the year's and not the school's ───────────────────────────────
/// A staff list is redrawn every September. Who takes maths at collège this
/// year is a fact about *this* year: a teacher leaves, a vacataire is taken on
/// for one year of Tamazight, a professeur de physique is asked to cover maths
/// only while a colleague is on leave. Held against the school, all of that
/// silently rewrote last year — and last year's grid is what a register, a
/// remplacement and an inspection are read against.
///
/// It also makes the September routine honest: the qualifications are declared
/// for the new year alongside the cursus and the bell schedule, rather than
/// inherited by default from a list nobody has looked at since.
///
/// ── The level scope ─────────────────────────────────────────────────────────
/// A qualification is rarely school-wide. The same subject at 2AP and at 2BAC
/// is not the same job, and a school that lets the primaire teacher be offered
/// a baccalauréat class will get a grid it has to unpick by hand. So a row
/// carries where it applies, from the narrowest declaration to the widest:
///
///   `levels` non-empty   → exactly those niveaux (Ahmad: maths at 2AP and 3AP)
///   `educationLevel` set → every niveau of that cycle (maths across le collège)
///   neither              → every niveau the school runs
///
/// Read in that order by `qualifiedFor` in modules/timetable/service.ts, which
/// is the only place that resolves it.
///
/// ── Why it hangs off User and not Staff ─────────────────────────────────────
/// Everything that books a teacher — TeachingAssignment, TimetableEntry,
/// TeacherUnavailability, TeacherAbsence — keys on `User`, because the grid is
/// about accounts that sign in and take a register. `Staff` is the payroll
/// identity and is deliberately optional on both sides: a vacataire who takes
/// four hours of Tamazight a week may have an account and no contract, and a
/// caretaker has a contract and teaches nothing. Keying this on Staff would put
/// the qualification on the half of the pair the timetable never looks at.
///
/// The workload cap lives on `Staff.maxWeeklyMinutes` for the opposite reason:
/// how many hours somebody may be given is a term of their employment. Anybody
/// without a contract row falls back to the week's own ceiling — see
/// `weekCapacityMinutes` in modules/timetable/service.ts.
model TeacherSubject {
  id       String @id @default(cuid()) @db.VarChar(30)
  schoolId String @db.VarChar(30)
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  /// The year this declaration is made for. Cascade: a year that is deleted
  /// takes its staffing plan with it, exactly as it takes its bell schedule.
  ///
  /// Denormalised alongside `schoolId`, which the year already implies, because
  /// every read here is "this school, this year" and the pair is what the
  /// composite index below is built on.
  schoolYearId String     @db.VarChar(30)
  schoolYear   SchoolYear @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)

  /// Cascade: the qualification is a fact about the account, and means nothing
  /// once it is gone.
  teacherId String @db.VarChar(30)
  teacher   User   @relation("TeacherSubjects", fields: [teacherId], references: [id], onDelete: Cascade)

  /// Cascade for the same reason — a subject the school has retired has no
  /// qualified teachers, it has no lessons.
  subjectId String  @db.VarChar(30)
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  /// Widest of the two level scopes: the whole cycle. Null = no cycle
  /// restriction, which with no `levels` either means the whole school.
  ///
  /// Cascade rather than SetNull: a cycle the school has stopped running has no
  /// qualifications *scoped to it* left to keep, and silently widening the row
  /// to school-wide would offer a primaire teacher to a lycée class.
  educationLevelId String?         @db.VarChar(30)
  educationLevel   EducationLevel? @relation(fields: [educationLevelId], references: [id], onDelete: Cascade)

  /// The niveaux this row applies to, when the school names them. Empty is the
  /// ordinary case and means "whatever `educationLevel` says" — see the note
  /// above. One row per niveau, in TeacherSubjectLevel.
  levels TeacherSubjectLevel[]

  /// Which subject this teacher should be given first when several will do.
  ///
  /// Lower is preferred. A professeur de physique who can cover maths in a
  /// pinch is rank 0 for physics and rank 2 for maths, and the generator will
  /// exhaust the maths specialists before reaching for them. Zero for
  /// everything is a perfectly good answer and the default, which is what makes
  /// the column optional in practice without being nullable.
  preferenceRank Int @default(0)

  /// Deactivated rather than deleted when a teacher stops covering a subject:
  /// the grids that already booked them stay readable, which a delete would
  /// not change but a reader looking for "why was he on this?" needs.
  isActive Boolean @default(true)

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One row per teacher per subject per year. Several niveaux go on `levels`,
  /// not on a second row — otherwise "Ahmad, maths, 2AP" and "Ahmad, maths,
  /// 3AP" would carry two preference ranks for one judgement.
  @@unique([schoolYearId, teacherId, subjectId])
  @@index([schoolId])
  @@index([schoolYearId])
  @@index([teacherId])
  @@index([subjectId])
  @@index([educationLevelId])
  @@index([schoolYearId, subjectId])
  @@map("teacher_subjects")
}
