/// A named bundle of permissions. `scope` decides where it can be assigned:
/// ORG roles go on User.orgRoleId, SCHOOL roles go on Membership.roleId.
model Role {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name        String
  description String?
  /// "ORG" | "SCHOOL" — see modules/access/enums.ts
  scope       String  @default("SCHOOL")
  /// System roles cannot be renamed or deleted, only their permissions tuned.
  isSystem    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permissions RolePermission[]
  memberships Membership[]
  orgUsers    User[]           @relation("UserOrgRole")

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("roles")
}
