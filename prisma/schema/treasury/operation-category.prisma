/// What a movement of money is *for*, at the level a school reports on.
///
/// Replaces the old `ExpenseCategory`, which only ever applied to money going
/// out. An encaissement has a rubrique too — a school wants "how much came in
/// under Scolarité versus under Transport" as much as it wants "how much went
/// out under Salaires" — and having one side of the ledger categorised and the
/// other not is why the caisse could never produce a statement.
///
/// Two levels, in two tables rather than a self-relation: the pair is a
/// *classification*, not a tree, and a self-relation would allow "Papeterie"
/// to be a top-level rubrique or to be nested three deep, neither of which a
/// school means. See OperationSubcategory.
model OperationCategory {
  id       String @id @default(cuid()) @db.VarChar(30)
  schoolId String @db.VarChar(30)
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  code   String
  name   String
  nameAr String?

  /// "IN" | "OUT" | "BOTH" — see modules/treasury/enums.ts.
  ///
  /// Which side of the ledger may use it. The décaissement form offers OUT and
  /// BOTH, the encaissement form IN and BOTH; a rubrique like "Régularisation"
  /// genuinely belongs on both sides, which is why this is not a boolean.
  kind String @default("OUT")

  position Int     @default(0)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subcategories OperationSubcategory[]
  motifs        OperationMotif[]
  operations    CashOperation[]
  /// Suppliers that post here by default — see Supplier.defaultCategoryId.
  suppliers     Supplier[]

  @@unique([schoolId, code])
  @@index([schoolId])
  @@index([schoolId, kind])
  @@map("operation_categories")
}
