/// What a décaissement was for: salaires, loyer, fournitures, entretien,
/// charges, transport.
///
/// Declared per school and year-independent, exactly as FeeType is on the
/// income side. The school decides the shape of its expense report once; the
/// amounts are facts of each operation, not of this table.
model ExpenseCategory {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  /// Short stable code, e.g. "SALAIRES", "LOYER", "FOURNITURES".
  code   String
  name   String
  nameAr String?

  position Int     @default(0)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  operations CashOperation[]

  @@unique([schoolId, code])
  @@index([schoolId])
  @@map("expense_categories")
}
