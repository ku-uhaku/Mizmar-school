/// The second level of the rubrique: "Papeterie" under "Fournitures".
///
/// Its own table rather than a `parentId` on OperationCategory, because the two
/// levels are not the same kind of thing. A category is what the school reports
/// on and what the décaissement form filters by; a sub-category exists only
/// inside one, has no `kind` of its own, and can never be chosen alone. A
/// self-relation would say all of that is optional.
///
/// Cascade: dropping a rubrique drops its sub-rubriques with it. The operations
/// that referenced them keep their own `label` and their `categoryId` is set to
/// null rather than deleted — see CashOperation.
model OperationSubcategory {
  id         String            @id @default(cuid())
  categoryId String
  category   OperationCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  code   String
  name   String
  nameAr String?

  position Int     @default(0)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  operations CashOperation[]
  suppliers  Supplier[]

  /// Unique within its parent, not across the school: "Divers" under Fournitures
  /// and "Divers" under Entretien are two different lines on a statement.
  @@unique([categoryId, code])
  @@index([categoryId])
  @@map("operation_subcategories")
}
