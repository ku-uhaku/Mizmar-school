/// The programme: which subject is taught at which level, with what weight.
///
/// This is where the Moroccan grading system is configured. Marks are out of 20
/// and a level's average is the coefficient-weighted mean of its subjects, so
/// `coefficient` here is what decides how much a subject counts — Maths at
/// coefficient 7 in 2BAC Sciences Maths, coefficient 3 in 2BAC Lettres.
///
/// `trackId` null means "every track of this level", which is how the common
/// subjects (Arabic, Islamic education, EPS) are declared once instead of per
/// stream. A row with a track overrides nothing automatically — the service layer
/// resolves a class's programme as "rows for its track" ∪ "rows with no track".
///
/// Components (Subject.parentId set) get their own rows here, because which
/// components a subject is split into, and how they are weighted, changes with
/// the level: اللغة العربية is marked as one block in 6AP but split into
/// القراءة / الإملاء / التعبير الكتابي in 3AP. A subject's components at a level
/// are therefore "LevelSubject rows whose subject's parent is that subject".
model LevelSubject {
  id      String @id @default(cuid())
  levelId String
  level   Level  @relation(fields: [levelId], references: [id], onDelete: Cascade)

  /// Null = applies to every track of this level.
  trackId String?
  track   Track?  @relation(fields: [trackId], references: [id], onDelete: Cascade)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  /// Weight of this row **within its own scope**, not globally:
  ///
  ///   * subject with no parent → weight in the level average
  ///   * component (Subject.parentId set) → weight inside its parent's mark
  ///
  /// So اللغة العربية may carry coefficient 6 at 4AP while its components
  /// القراءة 2, الإملاء 1, التعبير الكتابي 2 divide that 6 between themselves.
  /// A component's coefficient is therefore never added to the level total —
  /// only its parent's is. Moroccan coefficients are small integers, typically
  /// 1–9.
  coefficient Int @default(1)

  /// Timetabled load per week, in minutes.
  ///
  /// Minutes rather than hours because Moroccan loads are routinely 1h30 or 2h30
  /// and summing floats across a dozen subjects drifts; the UI divides for
  /// display.
  weeklyMinutes Int?

  /// Subjects that carry no mark toward the average (some support or activity
  /// slots) are still timetabled, so they need a row but must not be averaged.
  isGraded Boolean @default(true)

  /// Whether a mark below the threshold blocks progression regardless of the
  /// overall average — used by matière éliminatoire rules in some streams.
  isEliminatory Boolean @default(false)

  position Int @default(0)

  /// Mirrors the nullable `trackId` so the unique index below actually fires —
  /// without it, two "all tracks" rows for the same subject would both be
  /// accepted and the subject's coefficient would be counted twice in every
  /// average. See lib/db-keys.ts.
  ///
  /// INVARIANT: always `levelSubjectScopeKey(trackId)` from
  /// modules/academics/enums.ts.
  scopeKey String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([levelId, subjectId, scopeKey])
  @@index([levelId])
  @@index([trackId])
  @@index([subjectId])
  @@map("level_subjects")
}
