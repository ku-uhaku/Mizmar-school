/// One line of a liste de fournitures: "2 cahiers 96 pages, grands carreaux".
///
/// A row per article rather than a paragraph, because a parent reads it as a
/// shopping list and ticks it off — and because the school wants to know that
/// three teachers all asked for the same ring binder, which prose cannot be
/// searched for.
model SupplyItem {
  id     String     @id @default(cuid())
  listId String
  list   SupplyList @relation(fields: [listId], references: [id], onDelete: Cascade)

  /// Which catalogue article this line asks for — see SupplyArticle.
  ///
  /// This is what makes two teachers' "stylo bleu" the same thing, and it is
  /// how the line is chosen: the editor offers the school's catalogue and never
  /// a free-text box.
  ///
  /// SetNull rather than Restrict or Cascade: an article withdrawn from the
  /// catalogue must not delete the lines that named it, nor block the
  /// withdrawal. The line keeps reading correctly because `label` below is a
  /// copy, not a lookup.
  articleId String?
  article   SupplyArticle? @relation(fields: [articleId], references: [id], onDelete: SetNull)

  /// What to buy, copied off the article when the list was written.
  ///
  /// Denormalised on purpose, exactly as `Assessment` copies its type's
  /// `maxScore`: renaming an article next year must not rewrite the list a
  /// family already shopped from.
  label   String
  labelAr String?

  /// How many. Nullable because "des crayons de couleur" is a real answer and
  /// inventing a number would be worse than leaving it open.
  quantity Int?

  /// Colour, size, brand if it genuinely matters.
  notes String?

  /// Whether the child must have it. An optional line is a suggestion, and
  /// telling the two apart is what stops a family buying things it need not.
  isRequired Boolean @default(true)

  /// Order on the printed list.
  position Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([listId])
  @@index([articleId])
  @@map("supply_items")
}
