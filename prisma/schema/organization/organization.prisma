/// The single tenant this deployment serves. It owns every school, user and
/// role. Modelled as a table (rather than config) so it can be edited in-app.
model Organization {
  id        String  @id @default(cuid()) @db.VarChar(30)
  name      String
  legalName String?
  /// Moroccan "Identifiant Commun de l'Entreprise".
  ice       String?
  taxId     String?

  email   String?
  phone   String?
  website String?

  addressLine String? @db.Text
  city        String?
  region      String?
  postalCode  String?
  country     String  @default("MA")

  logoUrl       String? @db.MediumText
  defaultLocale String  @default("fr")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schools School[]
  users   User[]
  roles   Role[]

  /// What its people are waiting to be told — see modules/notifications.
  notifications Notification[]

  @@map("organizations")
}
